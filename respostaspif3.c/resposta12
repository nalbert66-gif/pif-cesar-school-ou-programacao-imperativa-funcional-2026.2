#include <stdio.h>

int main() {
    printf("%-10s %-10s %-10s\n", "Celsius", "Fahrenheit", "Kelvin");
    printf("--------------------------------\n");
    
    for (float c = 0; c <= 100; c += 5) {
        float f = (9 * c) / 5 + 32;
        float k = c + 273.15;
        printf("%-10.2f %-10.2f %-10.2f\n", c, f, k);
    }
    
    return 0;
}
