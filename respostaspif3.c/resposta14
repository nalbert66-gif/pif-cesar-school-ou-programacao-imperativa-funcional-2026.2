#include <stdio.h>

int main() {
    long long int soma_quadrados = 0;
    
    for (int i = 1; i <= 100; i++) {
        int quadrado = i * i;
        printf("%d -> %d\n", i, quadrado);
        soma_quadrados += quadrado;
    }
    
    printf("Soma total dos quadrados = %lld\n", soma_quadrados);
    
    return 0;
}
