#include <stdio.h>

int main() {
    float nota, maior = -1.0, menor = 11.0, soma = 0.0;
    int contador = 0;
    
    while (1) {
        printf("Digite a nota do aluno (ou -1.0 para sair): ");
        scanf("%f", &nota);
        
        if (nota == -1.0) {
            break;
        }
        
        if (nota >= 0.0 && nota <= 10.0) {
            if (nota > maior) maior = nota;
            if (nota < menor) menor = nota;
            soma += nota;
            contador++;
        }
    }
    
    if (contador > 0) {
        printf("Total de alunos: %d\n", contador);
        printf("Maior nota: %.2f\n", maior);
        printf("Menor nota: %.2f\n", menor);
        printf("Media geral: %.2f\n", soma / contador);
    } else {
        printf("Nenhuma nota registrada.\n");
    }
    
    return 0;
}
