#include <stdio.h>

int main() {
    int L;
    
    printf("Digite a dimensao L do quadrado (3 a 20): ");
    scanf("%d", &L);
    
    for (int i = 0; i < L; i++) {
        for (int j = 0; j < L; j++) {
            if (i == 0 || i == L - 1 || j == 0 || j == L - 1) {
                printf("X");
            } else {
                printf(" ");
            }
        }
        printf("\n");
    }
    
    return 0;
}
