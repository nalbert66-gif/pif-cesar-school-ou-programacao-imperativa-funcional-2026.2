#include <stdio.h>

int main() {
    int n, divisores = 0;
    
    printf("Digite um numero inteiro positivo: ");
    scanf("%d", &n);
    
    for (int i = 1; i <= n; i++) {
        if (n % i == 0) {
            divisores++;
        }
    }
    
    if (divisores == 2) {
        printf("O numero %d E PRIMO (encontrados %d divisores).\n", n, divisores);
    } else {
        printf("O numero %d NAO E PRIMO (encontrados %d divisores).\n", n, divisores);
    }
    
    return 0;
}
