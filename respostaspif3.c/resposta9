#include <stdio.h>

int main() {
    float valor, soma = 0.0;
    int contador = 0;
    
    while (1) {
        printf("Digite um valor real positivo (negativo para parar): ");
        scanf("%f", &valor);
        
        if (valor < 0) {
            break;
        }
        
        soma += valor;
        contador++;
    }
    
    if (contador > 0) {
        printf("Valores validos: %d\n", contador);
        printf("Soma total: %.2f\n", soma);
        printf("Media: %.2f\n", soma / contador);
    } else {
        printf("Nenhum valor valido foi digitado.\n");
    }
    
    return 0;
}
