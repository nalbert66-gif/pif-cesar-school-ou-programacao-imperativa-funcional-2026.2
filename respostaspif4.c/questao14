#include <stdio.h>

int main() {
    float nota;
    int faltas;
    scanf("%f %d", &nota, &faltas);
    
    if (nota >= 9.0) printf("Conceito %c\n", faltas <= 20 ? 'A' : 'B');
    else if (nota >= 7.5) printf("Conceito %c\n", faltas <= 20 ? 'B' : 'C');
    else if (nota >= 5.0) printf("Conceito %c\n", faltas <= 20 ? 'C' : 'D');
    else if (nota >= 4.0) printf("Conceito %c\n", faltas <= 20 ? 'D' : 'E');
    else printf("Conceito E\n");
    
    return 0;
}
