#include <stdio.h>

int main() {
    float valor, valorFinal, comissao;
    int opcao;
    scanf("%f %d", &valor, &opcao);
    
    if (opcao == 1) {
        valorFinal = valor * 0.90;
        comissao = valorFinal * 0.05;
        printf("Valor a pagar: R$ %.2f\n", valorFinal);
        printf("Comissao: R$ %.2f\n", comissao);
    } else if (opcao == 2) {
        printf("Valor da parcela: R$ %.2f\n", valor / 3);
        printf("Comissao: R$ %.2f\n", valor * 0.05);
    }
    return 0;
}
