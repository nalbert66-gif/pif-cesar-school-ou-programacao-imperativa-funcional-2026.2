#include <stdio.h>
#include <math.h>

int main() {
    float a, b, c, delta;
    scanf("%f %f %f", &a, &b, &c);
    if (a == 0) return 0;
    
    delta = (b * b) - (4 * a * c);
    
    if (delta < 0) {
        printf("A equacao nao possui raizes reais.\n");
    } else if (delta == 0) {
        printf("x = %.2f\n", -b / (2 * a));
    } else {
        printf("x1 = %.2f\n", (-b + sqrt(delta)) / (2 * a));
        printf("x2 = %.2f\n", (-b - sqrt(delta)) / (2 * a));
    }
    return 0;
}
