#include <stdio.h>

int main() {
    float salario, aumento = 0;
    int cargo;
    scanf("%f %d", &salario, &cargo);
    
    if (cargo == 1) aumento = salario <= 3000 ? salario * 0.15 : salario * 0.10;
    else if (cargo == 2) aumento = salario <= 5000 ? salario * 0.10 : salario * 0.05;
    else if (cargo == 3) aumento = salario * 0.08;
    
    printf("Aumento: R$ %.2f\nNovo Salario: R$ %.2f\n", aumento, salario + aumento);
    return 0;
}
