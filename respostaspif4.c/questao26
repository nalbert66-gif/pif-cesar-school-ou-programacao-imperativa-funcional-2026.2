#include <stdio.h>

int main() {
    int mes, ano;
    scanf("%d %d", &mes, &ano);
    
    if (mes == 2) {
        if ((ano % 400 == 0) || (ano % 4 == 0 && ano % 100 != 0))
            printf("Fevereiro: 29 dias\n");
        else
            printf("Fevereiro: 28 dias\n");
    } else if (mes == 4 || mes == 6 || mes == 9 || mes == 11) {
        printf("30 dias\n");
    } else if (mes >= 1 && mes <= 12) {
        printf("31 dias\n");
    } else {
        printf("Mes invalido\n");
    }
    return 0;
}
