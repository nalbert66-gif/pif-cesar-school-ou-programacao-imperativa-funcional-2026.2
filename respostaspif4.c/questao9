#include <stdio.h>

int main() {
    float lab, sem, final, media;
    scanf("%f %f %f", &lab, &sem, &final);
    media = ((lab * 2) + (sem * 3) + (final * 5)) / 10.0;
    
    if (media >= 5.0) printf("Aprovado\n");
    else if (media >= 3.0) printf("Em Recuperacao\n");
    else printf("Reprovado\n");
    return 0;
}
