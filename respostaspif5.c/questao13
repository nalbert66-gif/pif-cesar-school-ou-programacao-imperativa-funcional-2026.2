#include <stdio.h>

float soma(float a, float b);
float subtrai(float a, float b);
float multiplica(float a, float b);
float divide(float a, float b);

int main() {
    int op;
    float n1, n2;
    
    printf("1 - Soma\n2 - Subtrai\n3 - Multiplica\n4 - Divide\nEscolha: ");
    scanf("%d", &op);
    scanf("%f %f", &n1, &n2);
    
    switch(op) {
        case 1: printf("%.2f\n", soma(n1, n2)); break;
        case 2: printf("%.2f\n", subtrai(n1, n2)); break;
        case 3: printf("%.2f\n", multiplica(n1, n2)); break;
        case 4: 
            if (n2 != 0) {
                printf("%.2f\n", divide(n1, n2));
            } else {
                printf("Erro: divisao por zero.\n");
            }
            break;
        default: printf("Invalido.\n");
    }
    return 0;
}

float soma(float a, float b) { return a + b; }
float subtrai(float a, float b) { return a - b; }
float multiplica(float a, float b) { return a * b; }
float divide(float a, float b) { return a / b; }
