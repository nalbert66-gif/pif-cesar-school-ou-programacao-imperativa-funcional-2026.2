#include <stdio.h>

long fatorialIterativo(int n);
long fatorialRecursivo(int n);

int main() {
    int num;
    scanf("%d", &num);
    
    if (num >= 0) {
        printf("Iterativo: %ld\n", fatorialIterativo(num));
        printf("Recursivo: %ld\n", fatorialRecursivo(num));
    }
    return 0;
}

long fatorialIterativo(int n) {
    long fat = 1;
    for (int i = 1; i <= n; i++) {
        fat *= i;
    }
    return fat;
}

long fatorialRecursivo(int n) {
    if (n == 0) return 1;
    return n * fatorialRecursivo(n - 1);
}