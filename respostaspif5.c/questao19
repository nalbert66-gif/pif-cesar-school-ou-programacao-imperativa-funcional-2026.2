#include <stdio.h>

void contagem(int n);
void contagemProgressiva(int n);

int main() {
    int num;
    scanf("%d", &num);
    if (num > 0) {
        contagem(num);
        printf("---\n");
        contagemProgressiva(num);
    }
    return 0;
}

void contagem(int n) {
    
    if (n == 0) {
        printf("Fogo!\n");
        return;
    }
    
    printf("%d\n", n);
    contagem(n - 1);
}

void contagemProgressiva(int n) {
    
    if (n == 0) {
        return;
    }
    contagemProgressiva(n - 1);
    
    printf("%d\n", n);

