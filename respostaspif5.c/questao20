#include <stdio.h>

int ehPrimo(int n);

int main() {
    int num;
    scanf("%d", &num);
    
    if (ehPrimo(num) == 1) printf("E primo.\n");
    else printf("Nao e primo.\n");
    
    printf("Primos ate 50:\n");
    for (int i = 1; i <= 50; i++) {
        if (ehPrimo(i) == 1) {
            printf("%d ", i);
        }
    }
    printf("\n");
    return 0;
}

int ehPrimo(int n) {
    if (n <= 1) return 0;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) return 0;
    }
    return 1;
}
