#include <stdio.h>

#define DOBRO_ERRADO(x) x*2
#define DOBRO_CERTO(x) ((x)*2)

int dobro(int x);

int main() {
    printf("Macro errada: %d\n", DOBRO_ERRADO(2+3));
    printf("Funcao: %d\n", dobro(2+3));
    printf("Macro correta: %d\n", DOBRO_CERTO(2+3));
    

    
    return 0;
}

int dobro(int x) {
    return x * 2;
}