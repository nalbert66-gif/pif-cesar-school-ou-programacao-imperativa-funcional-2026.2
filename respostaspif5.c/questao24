#include <stdio.h>

#define DEBUG

int somaAteN(int n);

int main() {
    int n;
    scanf("%d", &n);
    printf("Total: %d\n", somaAteN(n));
    return 0;
}

int somaAteN(int n) {
    int soma = 0;
    for (int i = 1; i <= n; i++) {
        soma += i;
        
        #ifdef DEBUG
        printf("Iteracao %d, soma parcial: %d\n", i, soma);
        #endif
        
    }
    return soma;
}