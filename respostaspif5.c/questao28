#include <stdio.h>

float calculaSubtotal(float preco, int quantidade);
float aplicaDesconto(float valor, int opcaoPagamento);
float calculaTroco(float total, float pago);

int main() {
    float preco, pago, subtotal, total_pagar, troco;
    int qtd, op;
    
    scanf("%f %d %d %f", &preco, &qtd, &op, &pago);
    
    subtotal = calculaSubtotal(preco, qtd);
    total_pagar = aplicaDesconto(subtotal, op);
    troco = calculaTroco(total_pagar, pago);
    
    printf("Subtotal: R$ %.2f\n", subtotal);
    printf("Total a pagar: R$ %.2f\n", total_pagar);
    if (troco >= 0) {
        printf("Troco: R$ %.2f\n", troco);
    } else {
        printf("Falta dinheiro!\n");
    }
    
    return 0;
}

float calculaSubtotal(float preco, int quantidade) {
    return preco * quantidade;
}

float aplicaDesconto(float valor, int opcaoPagamento) {
    if (opcaoPagamento == 1) return valor * 0.90;
    return valor;
}

float calculaTroco(float total, float pago) {
    return pago - total;
}